<!-- Table definitions for the patches in this repo (NC Flash / EcuFlash metadata format, LFJ1EE).
     1. Back up your lfj1ee.xml.  2. Paste the <scaling> lines next to the other <scaling> entries.
     3. Paste the <table> lines for the patches you installed next to the other <table> entries.  4. Restart NC Flash. -->

<!-- scalings -->
<scaling name="igncut_enable" units="0=off 1=on" toexpr="x" frexpr="x" format="%0.0f" min="0" max="1" inc="1" storagetype="float" endian="big"/>
<scaling name="igncut_offset" units="rpm" toexpr="x" frexpr="x" format="%0.0f" min="-1000" max="0" inc="10" storagetype="float" endian="big"/>
<scaling name="igncut_dwell" units="ms" toexpr="x" frexpr="x" format="%0.3f" min="0.2" max="3" inc="0.05" storagetype="float" endian="big"/>
<scaling name="igncut_retard" units="deg" toexpr="x" frexpr="x" format="%0.1f" min="0" max="15" inc="0.5" storagetype="float" endian="big"/>
<scaling name="igncut_rpm0" units="rpm (0 = off)" toexpr="x" frexpr="x" format="%0.0f" min="0" max="7500" inc="50" storagetype="float" endian="big"/>
<scaling name="igncut_kmh" units="km/h" toexpr="x" frexpr="x" format="%0.0f" min="2" max="40" inc="1" storagetype="float" endian="big"/>
<scaling name="igncut_pct" units="% pedal" toexpr="x" frexpr="x" format="%0.0f" min="20" max="100" inc="5" storagetype="float" endian="big"/>
<scaling name="blip_enable" units="0=off 1=on" toexpr="x" frexpr="x" format="%0.0f" min="0" max="1" inc="1" storagetype="float" endian="big"/>
<scaling name="blip_pct" units="% pedal" toexpr="x" frexpr="x" format="%0.1f" min="0" max="40" inc="1" storagetype="float" endian="big"/>
<scaling name="blip_kmh" units="km/h" toexpr="x" frexpr="x" format="%0.0f" min="0" max="100" inc="1" storagetype="float" endian="big"/>
<scaling name="blip_addr" units="RAM address" toexpr="x" frexpr="x" format="%08x" min="0" max="0" inc="1" storagetype="uint32" endian="big"/>
<scaling name="rm_calls" units="calls (max 600)" toexpr="x" frexpr="x" format="%0.0f" min="1" max="600" inc="10" storagetype="uint16" endian="big"/>
<scaling name="rm_gain" units="" toexpr="x" frexpr="x" format="%0.3f" min="0" max="2" inc="0.005" storagetype="float" endian="big"/>
<scaling name="rm_ofs" units="rpm" toexpr="x" frexpr="x" format="%0.0f" min="-500" max="1000" inc="25" storagetype="float" endian="big"/>
<scaling name="rm_rpm" units="rpm" toexpr="x" frexpr="x" format="%0.0f" min="1000" max="7500" inc="100" storagetype="float" endian="big"/>
<scaling name="rm_k" units="rpm per km/h" toexpr="x" frexpr="x" format="%0.1f" min="0" max="200" inc="0.5" storagetype="float" endian="big"/>
<scaling name="ov_pct" units="%" toexpr="x" frexpr="x" format="%0.0f" min="0" max="100" inc="5" storagetype="float" endian="big"/>
<scaling name="ov_sec" units="s (max 5)" toexpr="x" frexpr="x" format="%0.1f" min="0" max="5" inc="0.1" storagetype="float" endian="big"/>
<scaling name="ov_rpm" units="rpm" toexpr="x" frexpr="x" format="%0.0f" min="1500" max="7500" inc="100" storagetype="float" endian="big"/>
<scaling name="ov_kmh" units="km/h (0 = any speed)" toexpr="x" frexpr="x" format="%0.0f" min="0" max="200" inc="5" storagetype="float" endian="big"/>
<scaling name="ov_degc" units="deg C" toexpr="x" frexpr="x" format="%0.0f" min="40" max="110" inc="1" storagetype="float" endian="big"/>
<scaling name="ov_deg" units="deg retard (max 45)" toexpr="x" frexpr="x" format="%0.1f" min="0" max="45" inc="0.5" storagetype="float" endian="big"/>
<scaling name="ov_lambda" units="lambda (stock Ford burble 0.92-1.0)" toexpr="x" frexpr="x" format="%0.3f" min="0.85" max="1.5" inc="0.01" storagetype="float" endian="big"/>
<scaling name="ov_rpmax" units="rpm (4 points, increasing)" toexpr="x" frexpr="x" format="%0.0f" min="500" max="8000" inc="100" storagetype="float" endian="big"/>
<scaling name="ov_rate" units="calls per second" toexpr="x" frexpr="x" format="%0.0f" min="10" max="1000" inc="1" storagetype="float" endian="big"/>

